{
    "alias": "porch",
    "description": "Porch (local conformance run, test/conformance/run.sh)",
    "server": {
        "discoveryUrl": "https://porch:8443/.well-known/openid-configuration"
    },
    "client": {
        "client_id": "{CLIENT_ID}",
        "client_secret": "{CLIENT_SECRET}"
    },
    "client2": {
        "client_id": "{CLIENT2_ID}",
        "client_secret": "{CLIENT2_SECRET}"
    },
    "client_secret_post": {
        "client_id": "{POST_CLIENT_ID}",
        "client_secret": "{POST_CLIENT_SECRET}"
    },
    "browser": [
        {
            "comment": "Authorization: Porch -> (front proxy login shim) -> fake Google account picker -> Porch callback -> suite callback",
            "match": "https://porch:8443/*",
            "tasks": [
                {
                    "task": "Pick the Ada Smith account at the fake Google",
                    "optional": true,
                    "match": "http://fakegoogle:9000/authorize*",
                    "commands": [
                        ["click", "xpath", "//button[@value='ada']"]
                    ]
                },
                {
                    "task": "Verify Complete",
                    "match": "*/test/a/porch/callback*",
                    "commands": [
                        ["wait", "id", "submission_complete", 10]
                    ]
                }
            ]
        }
    ],
    "override": {
        "oidcc-prompt-login": {
            "browser": [
                {
                    "comment": "second authorization (prompt=login): the upstream sign-in page is shown again; upload it as the screenshot",
                    "match": "https://porch:8443/*",
                    "tasks": [
                        {
                            "task": "Pick the Ada Smith account at the fake Google",
                            "optional": true,
                            "match": "http://fakegoogle:9000/authorize*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "Fake Google", "update-image-placeholder-optional"],
                                ["click", "xpath", "//button[@value='ada']"]
                            ]
                        },
                        {
                            "task": "Verify Complete",
                            "match": "*/test/a/porch/callback*",
                            "commands": [
                                ["wait", "id", "submission_complete", 10]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-max-age-1": {
            "browser": [
                {
                    "comment": "second authorization (max_age=1): the upstream sign-in page is shown again; upload it as the screenshot",
                    "match": "https://porch:8443/*",
                    "tasks": [
                        {
                            "task": "Pick the Ada Smith account at the fake Google",
                            "optional": true,
                            "match": "http://fakegoogle:9000/authorize*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "Fake Google", "update-image-placeholder-optional"],
                                ["click", "xpath", "//button[@value='ada']"]
                            ]
                        },
                        {
                            "task": "Verify Complete",
                            "match": "*/test/a/porch/callback*",
                            "commands": [
                                ["wait", "id", "submission_complete", 10]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-ensure-registered-redirect-uri": {
            "browser": [
                {
                    "comment": "Porch must show an error itself (never redirect to an unregistered redirect_uri); upload the error page",
                    "match": "https://porch:8443/*",
                    "tasks": [
                        {
                            "task": "Error page",
                            "match": "https://porch:8443/oauth2/authorize*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "redirect_uri", "update-image-placeholder"]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-ensure-request-object-with-redirect-uri": {
            "browser": [
                {
                    "comment": "the outer redirect_uri is unregistered; Porch does not process request objects, so it must show an error page",
                    "match": "https://porch:8443/*",
                    "tasks": [
                        {
                            "task": "Error page",
                            "match": "https://porch:8443/oauth2/authorize*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "redirect_uri", "update-image-placeholder"]
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
