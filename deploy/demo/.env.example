# Copy to deploy/demo/.env to change the demo defaults (read by compose, up.sh and down.sh).
# Host port Caddy publishes on 127.0.0.1 (and listens on inside its container). 18443 is often taken by pulse-dev.
DEMO_HTTPS_PORT=28443
# Fixed subnet of the demo network: Porch trusts it as proxy and allows outbound calls into it (fake Google).
DEMO_SUBNET=172.30.213.0/24
# Shared secret between Porch and the fake Google provider.
DEMO_GOOGLE_CLIENT_SECRET=porch-demo-upstream-secret
