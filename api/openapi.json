{
  "components": {
    "schemas": {
      "AddMemberRequest": {
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "type": "object"
      },
      "AuditVerification": {
        "additionalProperties": false,
        "properties": {
          "broken_at": {
            "format": "int64",
            "type": "integer"
          },
          "events": {
            "format": "int64",
            "type": "integer"
          },
          "ok": {
            "type": "boolean"
          },
          "problem": {
            "type": "string"
          }
        },
        "required": [
          "events",
          "ok"
        ],
        "type": "object"
      },
      "CreateTenantRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "slug": {
            "maxLength": 63,
            "minLength": 2,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name"
        ],
        "type": "object"
      },
      "CreateUserRequest": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "primary_email": {
            "description": "Attribute only; never used to link login identities.",
            "maxLength": 254,
            "type": "string"
          }
        },
        "required": [
          "display_name"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "InstallationInfo": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "security_epoch": {
            "format": "int64",
            "type": "integer"
          },
          "setup_completed_at": {
            "format": "date-time",
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "security_epoch",
          "created_at"
        ],
        "type": "object"
      },
      "Me": {
        "additionalProperties": false,
        "properties": {
          "csrf_token": {
            "description": "Send as X-Porch-CSRF on state-changing requests.",
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/MeMembership"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "operator_roles": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "public_id": {
            "type": "string"
          },
          "session": {
            "$ref": "#/components/schemas/SessionInfo"
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "public_id",
          "display_name",
          "operator_roles",
          "memberships",
          "session",
          "csrf_token"
        ],
        "type": "object"
      },
      "MeMembership": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "tenant_name": {
            "type": "string"
          },
          "tenant_slug": {
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "tenant_slug",
          "tenant_name",
          "status"
        ],
        "type": "object"
      },
      "Member": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "last_changed_by": {
            "type": "string"
          },
          "managed_by": {
            "type": "string"
          },
          "source": {
            "description": "manual, terraform, setup, domain_rule:\u003cid\u003e, dirsync:\u003cid\u003e",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "suspended"
            ],
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "version": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "tenant_id",
          "user_id",
          "status",
          "source",
          "version",
          "managed_by",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "MemberList": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Member"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Operator": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "display_name",
          "role",
          "source",
          "created_at"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable error code, e.g. validation_failed, not_found, precondition_failed, reauth_required.",
            "type": "string"
          },
          "detail": {
            "description": "Explanation of this occurrence.",
            "type": "string"
          },
          "errors": {
            "description": "Request-schema validation details.",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "fields": {
            "description": "Per-field validation problems.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "description": "HTTP status code.",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "Short summary of the problem type.",
            "type": "string"
          },
          "type": {
            "description": "URI reference identifying the problem type.",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "SessionInfo": {
        "additionalProperties": false,
        "properties": {
          "auth_time": {
            "format": "date-time",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "method",
          "auth_time",
          "expires_at"
        ],
        "type": "object"
      },
      "SetupRequest": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "type": "string"
          },
          "token": {
            "description": "Setup token printed by 'porch admin setup-token'.",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token",
          "display_name"
        ],
        "type": "object"
      },
      "SetupStatus": {
        "additionalProperties": false,
        "properties": {
          "completed": {
            "type": "boolean"
          }
        },
        "required": [
          "completed"
        ],
        "type": "object"
      },
      "Tenant": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "last_changed_by": {
            "type": "string"
          },
          "managed_by": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "session_absolute_seconds": {
            "description": "Per-tenant absolute lifetime override (0 = installation default).",
            "format": "int64",
            "type": "integer"
          },
          "session_idle_seconds": {
            "description": "Per-tenant idle timeout override (0 = installation default).",
            "format": "int64",
            "type": "integer"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "disabled"
            ],
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "version": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "status",
          "version",
          "managed_by",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "TenantList": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Tenant"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "UpdateMemberRequest": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "active",
              "suspended"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "UpdateTenantRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "session_absolute_seconds": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "session_idle_seconds": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "enum": [
              "active",
              "disabled"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateUserRequest": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "primary_email": {
            "maxLength": 254,
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "disabled"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "User": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "last_changed_by": {
            "type": "string"
          },
          "last_login_at": {
            "format": "date-time",
            "type": "string"
          },
          "managed_by": {
            "type": "string"
          },
          "primary_email": {
            "type": "string"
          },
          "public_id": {
            "description": "Stable OIDC subject (sub) of this user.",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "disabled"
            ],
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "version": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "public_id",
          "display_name",
          "status",
          "version",
          "managed_by",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "UserList": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/User"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "__Host-porch_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Management API for Porch. Browser clients authenticate with the __Host-porch_session cookie and send the session's CSRF token in X-Porch-CSRF on state-changing requests. Automation clients use `Authorization: Bearer porch_at_…` (milestone M6).",
    "title": "Porch management API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/installation": {
      "get": {
        "operationId": "get-installation",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallationInfo"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Installation status",
        "tags": [
          "installation"
        ]
      }
    },
    "/installation/audit/verify": {
      "get": {
        "operationId": "verify-audit-chain",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditVerification"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Verify the audit log hash chain",
        "tags": [
          "installation"
        ]
      }
    },
    "/installation/operators": {
      "get": {
        "operationId": "list-operators",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Operator"
                  },
                  "type": [
                    "array",
                    "null"
                  ]
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Users with installation roles",
        "tags": [
          "installation"
        ]
      }
    },
    "/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "End the current session",
        "tags": [
          "session"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "get-me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "The authenticated caller",
        "tags": [
          "session"
        ]
      }
    },
    "/setup": {
      "post": {
        "description": "Creates the owner and a short setup session (1 h) used to enroll a login method. Only works while no operator exists.",
        "operationId": "complete-setup",
        "parameters": [
          {
            "in": "header",
            "name": "User-Agent",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Created",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Consume a setup token and create the first installation owner",
        "tags": [
          "session"
        ]
      }
    },
    "/setup/status": {
      "get": {
        "operationId": "get-setup-status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Whether first-run setup is complete",
        "tags": [
          "session"
        ]
      }
    },
    "/tenants": {
      "get": {
        "operationId": "list-tenants",
        "parameters": [
          {
            "description": "Page size.",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "description": "Page size.",
              "format": "int64",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor from next_cursor.",
            "explode": false,
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Opaque cursor from next_cursor.",
              "maxLength": 128,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantList"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "List tenants",
        "tags": [
          "tenants"
        ]
      },
      "post": {
        "operationId": "create-tenant",
        "parameters": [
          {
            "description": "Provenance of the change (informational).",
            "in": "header",
            "name": "X-Porch-Managed-By",
            "schema": {
              "description": "Provenance of the change (informational).",
              "enum": [
                "ui",
                "api",
                "terraform"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tenant"
                }
              }
            },
            "description": "Created",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Create a tenant",
        "tags": [
          "tenants"
        ]
      }
    },
    "/tenants/{tenant}": {
      "delete": {
        "operationId": "delete-tenant",
        "parameters": [
          {
            "description": "Tenant ID or slug.",
            "in": "path",
